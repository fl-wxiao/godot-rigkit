; Engine configuration file.
; RigKit — runtime rig extensions for Godot 4.
; Open this folder in Godot 4.4+; the addon lives in addons/rigkit.

config_version=5

[application]

config/name="RigKit FootLock Demo"
config/description="Runtime foot lock + two-bone IK for Godot 4"
run/main_scene="res://demo/demo.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.08, 0.08, 0.1, 1)
